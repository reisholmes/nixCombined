+// clampPercentage keeps the build progress in [0, 1]; out-of-range or NaN
+// values make strings.Repeat panic in the progress bar.
+func clampPercentage(p float64) float64 {
+	if p != p {
+		return 0
+	}
+	if p < 0 {
+		return 0
+	}
+	if p > 1 {
+		return 1
+	}
+	return p
